				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
					<font size="9" isBold="true" isUnderline="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[tr($V{L}, "OBSERVACIONES")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="3" y="13" width="547" height="13" uuid="8bc8a6b6-9b41-4e49-ab45-2b1efbe94459"/>
				<textElement textAlignment="Left" markup="html">
					<font size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[(
    $F{applicable_regulations} != null
    && !$F{applicable_regulations}.trim().isEmpty()
        ? "<u>" + tr($V{L}, "NORMATIVA APLICABLE:") + "</u><br/>"
          + tr($V{L}, $F{applicable_regulations})
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
        : ""
)
+
(
    $F{applicable_regulations} != null
    && !$F{applicable_regulations}.trim().isEmpty()
    && $F{Comentarios-comments} != null
    && !$F{Comentarios-comments}.trim().isEmpty()
        ? "<br/>"
        : ""
)
+
(
    $F{Comentarios-comments} != null
    && !$F{Comentarios-comments}.trim().isEmpty()
        ? "<u>" + tr($V{L}, "COMENTARIOS:") + "</u><br/>"
          + tr($V{L}, $F{Comentarios-comments})
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
        : ""
)]]></textFieldExpression>
